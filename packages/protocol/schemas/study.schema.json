{
  "$defs": {
    "Boundary": {
      "properties": {
        "id": {
          "default": "",
          "title": "Id",
          "type": "string"
        },
        "type": {
          "enum": [
            "fixed",
            "force",
            "pressure",
            "gravity",
            "temperature",
            "heat_flux",
            "convection"
          ],
          "title": "Type",
          "type": "string"
        },
        "label": {
          "default": "",
          "title": "Label",
          "type": "string"
        },
        "faces": {
          "items": {
            "$ref": "#/$defs/FaceRef"
          },
          "title": "Faces",
          "type": "array"
        },
        "vector": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "force: total force in N over all faces; gravity: acceleration in m/s²",
          "title": "Vector"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "pressure MPa, temperature °C, heat_flux W total, convection W/(m²·K)",
          "title": "Value"
        },
        "ambient": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "convection: ambient temperature in °C",
          "title": "Ambient"
        }
      },
      "required": [
        "type"
      ],
      "title": "Boundary",
      "type": "object"
    },
    "Driver": {
      "description": "Drives one mate: a motor at a speed, a torque (force), or a move to a position.",
      "properties": {
        "mate": {
          "title": "Mate",
          "type": "string"
        },
        "kind": {
          "default": "speed",
          "enum": [
            "speed",
            "torque",
            "position"
          ],
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "description": "speed: rpm or mm/s; torque: N·m or N; position: deg or mm from the modelled position",
          "title": "Value",
          "type": "number"
        },
        "ramp": {
          "default": 0.2,
          "description": "Seconds to reach the value (smooth start)",
          "minimum": 0,
          "title": "Ramp",
          "type": "number"
        }
      },
      "required": [
        "mate",
        "value"
      ],
      "title": "Driver",
      "type": "object"
    },
    "FaceRef": {
      "properties": {
        "part": {
          "title": "Part",
          "type": "string"
        },
        "tag": {
          "title": "Tag",
          "type": "string"
        },
        "sig": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Geometric signature of the face when it was picked",
          "title": "Sig"
        }
      },
      "required": [
        "part",
        "tag"
      ],
      "title": "FaceRef",
      "type": "object"
    },
    "MeshSettings": {
      "properties": {
        "size": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Target element size in mm; empty = automatic",
          "title": "Size"
        },
        "order": {
          "default": 2,
          "enum": [
            1,
            2
          ],
          "title": "Order",
          "type": "integer"
        }
      },
      "title": "MeshSettings",
      "type": "object"
    },
    "MotionSetup": {
      "properties": {
        "duration": {
          "default": 2.0,
          "description": "Simulated time in s",
          "exclusiveMinimum": 0,
          "maximum": 600,
          "title": "Duration",
          "type": "number"
        },
        "timestep": {
          "default": 0.001,
          "description": "Integrator step in s",
          "maximum": 0.01,
          "minimum": 1e-05,
          "title": "Timestep",
          "type": "number"
        },
        "gravity": {
          "description": "m/s²",
          "items": {
            "type": "number"
          },
          "title": "Gravity",
          "type": "array"
        },
        "contacts": {
          "default": false,
          "description": "Collide parts that no mate connects (convex decomposition with CoACD)",
          "title": "Contacts",
          "type": "boolean"
        },
        "damping": {
          "default": 0.0,
          "description": "Damping on every joint, N·m·s/rad or N·s/mm",
          "minimum": 0,
          "title": "Damping",
          "type": "number"
        },
        "drivers": {
          "items": {
            "$ref": "#/$defs/Driver"
          },
          "title": "Drivers",
          "type": "array"
        },
        "springs": {
          "items": {
            "$ref": "#/$defs/Spring"
          },
          "title": "Springs",
          "type": "array"
        },
        "sweep": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sweep"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "samples": {
          "default": 400,
          "description": "Points in the time series",
          "maximum": 5000,
          "minimum": 20,
          "title": "Samples",
          "type": "integer"
        }
      },
      "title": "MotionSetup",
      "type": "object"
    },
    "Spring": {
      "properties": {
        "mate": {
          "title": "Mate",
          "type": "string"
        },
        "stiffness": {
          "default": 0.0,
          "description": "N·m/rad (revolute) or N/mm (prismatic)",
          "minimum": 0,
          "title": "Stiffness",
          "type": "number"
        },
        "damping": {
          "default": 0.0,
          "description": "N·m·s/rad (revolute) or N·s/mm (prismatic)",
          "minimum": 0,
          "title": "Damping",
          "type": "number"
        },
        "rest": {
          "default": 0.0,
          "description": "Unloaded position, deg or mm from the modelled position",
          "title": "Rest",
          "type": "number"
        }
      },
      "required": [
        "mate"
      ],
      "title": "Spring",
      "type": "object"
    },
    "Sweep": {
      "description": "Runs the study once per value, as parallel worlds (MuJoCo Warp on a CUDA target, a process pool elsewhere).",
      "properties": {
        "parameter": {
          "description": "drivers.<mate>.value, springs.<mate>.stiffness, springs.<mate>.damping, mass.<part> (kg) or damping",
          "title": "Parameter",
          "type": "string"
        },
        "values": {
          "items": {
            "type": "number"
          },
          "maxItems": 4096,
          "minItems": 1,
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "parameter",
        "values"
      ],
      "title": "Sweep",
      "type": "object"
    }
  },
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "type": {
      "default": "static",
      "enum": [
        "static",
        "modal",
        "thermal",
        "motion"
      ],
      "title": "Type",
      "type": "string"
    },
    "parts": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Parts in the study; empty = the whole assembly (parts are bonded where they touch)",
      "title": "Parts"
    },
    "materials": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Material per part id; default: the part's material",
      "title": "Materials",
      "type": "object"
    },
    "boundaries": {
      "items": {
        "$ref": "#/$defs/Boundary"
      },
      "title": "Boundaries",
      "type": "array"
    },
    "mesh": {
      "$ref": "#/$defs/MeshSettings"
    },
    "modes": {
      "default": 6,
      "maximum": 30,
      "minimum": 1,
      "title": "Modes",
      "type": "integer"
    },
    "safety_target": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Safety Target"
    },
    "target": {
      "default": "auto",
      "description": "Compute target id, or auto",
      "title": "Target",
      "type": "string"
    },
    "motion": {
      "anyOf": [
        {
          "$ref": "#/$defs/MotionSetup"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Motion studies: drivers, springs, duration, sweep"
    }
  },
  "required": [
    "id",
    "name"
  ],
  "title": "Study",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://newcad.dev/schemas/study.schema.json",
  "description": "A simulation study, stored as studies/<id>.yaml in the project repository. Units: mm, N, MPa, °C, W; motion studies: mm, deg, N, N·m, s, rpm."
}
